# Copia este archivo a  ~/.config/deepseek-usage-monitor/.env
#   mkdir -p ~/.config/deepseek-usage-monitor
#   cp .env.example ~/.config/deepseek-usage-monitor/.env

# Tu API key de https://platform.deepseek.com/api_keys  (OBLIGATORIA)
DEEPSEEK_API_KEY=sk-tu-clave-aqui

# Alerta de saldo bajo (USD) → indicador amarillo/rojo en la barra de menú
DSU_LOW_BALANCE=1.0

# Intervalo de refresco de la app de menú de macOS (segundos, mínimo 15)
DSU_MENUBAR_INTERVAL=120

# URL del dashboard local (el botón "Abrir dashboard" del menú)
DSU_DASHBOARD_URL=http://127.0.0.1:8000
